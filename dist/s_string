#!/usr/bin/env bash
set -euo pipefail
#
# Spell-check source files using cspell.

. "$(dirname -- "${BASH_SOURCE[0]}")/common_functions.sh"
cd_dist
check_fast_mode_flag

type cspell >/dev/null 2>&1 || { echo "$0 skipped: cspell not found"; exit 0; }

usage() { echo 'usage: s_string [-F]' >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -F) check_fast_mode; shift ;;
        *)  usage ;;
    esac
done

mapfile -t files < <(
    cd .. && find bench cmake dist examples ext lang oss src test tools \
        -type f -not -path '*/3rdparty/*' | filter_if_fast
)
[[ ${#files[@]} -eq 0 ]] && exit 0

cd .. && printf '%s\n' "${files[@]}" | xargs cspell lint \
    --no-progress --no-must-find-files --cache --cache-strategy content \
    --config cspell.json

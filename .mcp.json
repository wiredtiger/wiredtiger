{
  "mcpServers": {
    "wt": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "./tools/wt-mcp",
        "run",
        "server.py"
      ]
    },
    "devprod-mcp-gateway": {
      "type": "stdio",
      "command": "devprod-mcp-proxy",
      "args": [
        "--gateway",
        "https://app.devprod-mcp-gateway.prod.corp.mongodb.com/mcp"
      ]
    }
  }
}

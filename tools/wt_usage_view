def _show_help(stdscr, attr):
    """Scrollable '?' help overlay; the page content is fixed, only the viewport moves."""
    lines = HELP_TEXT.split("\n")
    top = 0
    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        for row in range(h - 1):
            if top + row >= len(lines):
                break
            try:
                stdscr.addstr(row, 0, lines[top + row][:w - 1], attr)
            except curses.error:
                pass
        foot = "j/k or arrows scroll   space page   q or ? to close"
        try:
            stdscr.addstr(h - 1, 0, foot[:w - 1], attr | curses.A_BOLD)
        except curses.error:
            pass
        stdscr.refresh()
        c = stdscr.getch()
        maxtop = max(0, len(lines) - (h - 1))
        if c in (ord("q"), ord("?"), 27):
            return
        elif c in (ord("j"), curses.KEY_DOWN):
            top = min(top + 1, maxtop)
        elif c in (ord("k"), curses.KEY_UP):
            top = max(top - 1, 0)
        elif c == ord(" "):
            top = min(top + (h - 1), maxtop)


def run_tui(stdscr, sections):
    curses.curs_set(0)
    stdscr.keypad(True)
    _define_shift_arrows()
    colors = _setup_colors()
    if colors:
        normal_attr, hi_attr = colors
        stdscr.bkgd(" ", normal_attr)
    else:
        normal_attr, hi_attr = curses.A_NORMAL, curses.A_REVERSE
    zoom = Zoom(*_global_span(sections))  # one time axis shared across all sections
    expanded = {}      # (section_index, bid) -> bool
    cursor = 0         # index into the navigable items
    top = 0            # first display line shown (vertical scroll)
    while True:
        items = _build_items(sections, zoom, expanded)
        cursor = max(0, min(cursor, len(items) - 1))

        # Flatten to display lines, remembering each line's owning item + anchor.
        lines = []  # (text, item_index, is_anchor)
        for ii, it in enumerate(items):
            lines.append((it["anchor"], ii, True))
            for b in it["body"]:
                lines.append((b, ii, False))
            if it["body"]:
                lines.append(("", ii, False))  # blank line below an expanded card
        # Scroll so the whole cursor item is visible -- its header *and*, when expanded,
        # its card body -- not just the header line. If the item is taller than the
        # screen, anchor it to the top so at least the card starts on screen.
        h, w = stdscr.getmaxyx()
        body_h = h - 1
        owned = [i for i, ln in enumerate(lines) if ln[1] == cursor]
        first, last = owned[0], owned[-1]
        if first < top:
            top = first
        elif last >= top + body_h:
            top = last - body_h + 1
            if first < top:  # item taller than the screen: show its start
                top = first

        stdscr.erase()
        for row in range(body_h):
            li = top + row
            if li >= len(lines):
                break
            text, ii, is_anchor = lines[li]
            text = _strip(text)[:w - 1]
            if ii == cursor and is_anchor:
                text = text.ljust(w - 1)  # extend the highlight across the row
                attr = hi_attr
            else:
                attr = normal_attr
            try:
                stdscr.addstr(row, 0, text, attr)
            except curses.error:
                pass
        try:
            stdscr.addstr(h - 1, 0, _HINTS[:w - 1], normal_attr | curses.A_BOLD)
        except curses.error:
            pass
        stdscr.refresh()

        c = stdscr.getch()
        if c == ord("q"):
            break
        elif c == ord("?"):
            _show_help(stdscr, normal_attr)
        elif c in (ord("j"), 14, curses.KEY_DOWN):  # move cursor down
            cursor = min(len(items) - 1, cursor + 1)
        elif c in (ord("k"), 16, curses.KEY_UP):    # move cursor up
            cursor = max(0, cursor - 1)
        elif c == ord(" "):
            it = items[cursor]
            sec = it["sec"]
            if it["bid"] is None:
                # Section header: collapse all in this section if any expanded, else expand all.
                in_sec = [x for x in items if x["bid"] is not None and x["sec"] == sec]
                any_exp = any(expanded.get((sec, x["bid"])) for x in in_sec)
                for x in in_sec:
                    expanded[(sec, x["bid"])] = not any_exp
            else:
                expanded[(sec, it["bid"])] = not expanded.get((sec, it["bid"]), False)
        elif c in (_SHIFT_RIGHT, curses.KEY_SRIGHT, ord("L")):  # pan time forward
            if not zoom.pan(1):
                curses.beep()
        elif c in (_SHIFT_LEFT, curses.KEY_SLEFT, ord("H")):    # pan time backward
            if not zoom.pan(-1):
                curses.beep()
        elif c in (_SHIFT_DOWN, ord("J")):                      # split more (finer)
            if not zoom.zoom_in():
                curses.beep()
        elif c in (_SHIFT_UP, ord("K")):                        # split less (coarser)
            if not zoom.zoom_out():
                curses.beep()


def _expand_paths(paths):
    """Expand directories to the metrics.* files within (skipping interim files)."""
    out = []
    for p in paths:
        if os.path.isdir(p):
            for root, _, files in os.walk(p):
                for f in files:
                    if f.startswith("metrics.") and "interim" not in f:
                        out.append(os.path.join(root, f))
        else:
            out.append(p)
    return sorted(out)


def _node_key(path):
    """A stable per-node key from the file path: a 'mongod.N' segment if present
    (DSI preserves it), else the parent directory name."""
    m = re.search(r"mongod\.\d+", path)
    if m:
        return m.group(0)
    return os.path.basename(os.path.dirname(path)) or os.path.basename(path)


def _global_span(sections):
    spans = [tl.span_ms() for _, tl in sections if tl.intervals]
    if not spans:
        return (0, 0)
    return (min(s[0] for s in spans), max(s[1] for s in spans))


_ROLE_ORDER = {"primary": 0, "secondary": 1, "unknown": 2}


def load_sections(paths, label_override=None):
    """Load metrics files/directories, group by node, merge each node's files by
    time, and return [(label, timeline)] sorted primary-first."""
    bynode = {}
    for f in _expand_paths(paths):
        try:
            tl = fu.load(f)
        except Exception:
            continue  # not a readable FTDC file; skip it
        if tl.intervals:
            bynode.setdefault(_node_key(f), []).append(tl)
    nodes = []
    for node, tls in bynode.items():
        merged = fu.merge_timelines(tls)
        nodes.append((node, fu.timeline_role(merged), merged))
    nodes.sort(key=lambda n: (_ROLE_ORDER.get(n[1], 2), n[0]))
    sections = []
    scount = 0
    for node, role, tl in nodes:
        if label_override and len(nodes) == 1:
            lbl = label_override
        elif role == "primary":
            lbl = "Primary [%s]" % node
        elif role == "secondary":
            scount += 1
            lbl = "Secondary S%d [%s]" % (scount, node)
        else:
            lbl = "[%s]" % node
        sections.append((lbl, tl))
    return sections


def main():
    ap = argparse.ArgumentParser(description="View WiredTiger btree usage stats from mongod FTDC.")
    ap.add_argument("metrics", nargs="+",
                    help="FTDC metrics.* file(s) or directories (one per replica; grouped by node)")
    ap.add_argument("--collapsed", action="store_true", help="one line per btree (leaderboard only)")
    ap.add_argument("--print", dest="print_static", action="store_true",
                    help="print a static report instead of the interactive viewer")
    ap.add_argument("--label", default=None, help="override the section label (single input only)")
    args = ap.parse_args()
    for p in args.metrics:
        if not os.path.exists(p):
            sys.exit("wt_usage_view: no such file or directory: %s" % p)
    sections = load_sections(args.metrics, args.label)
    if not sections:
        sys.exit(
            "wt_usage_view: no WiredTiger btree-usage stats found in the given input.\n"
            "  The FTDC has no 'usage_' keys -- it likely came from a mongod without the\n"
            "  WT-17717 usage sampling (a stock build emits none).")
    if args.collapsed or args.print_static or not sys.stdout.isatty():
        print(render(sections, expanded=not args.collapsed))
    else:
        curses.wrapper(run_tui, sections)


if __name__ == "__main__":
    main()

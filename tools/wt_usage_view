# Read ops, then a visual divider, then write ops -- separating reads from writes.
READ_COLS = ["search", "search_near"]
WRITE_COLS = ["insert", "insert_overwrite", "update", "modify", "remove"]
OP_LABEL = {
    "search": "srch", "search_near": "near", "insert": "ins",
    "insert_overwrite": "over", "update": "upd", "modify": "mod", "remove": "rem",
}
COL_W = 7          # width of one op column
RW_GAP = "    "    # divider between the read group and the write group
INDENT = "    "

# Position center-of-mass -> a slope cell whose glyph *and* horizontal offset encode
# the lean: '/' sits at column 0, '|' at 1, '\' at 2, with '/|' and '|\' spanning.
_SLOPE_CELL = [(0.7, "/"), (1.5, "/|"), (2.5, " |"), (3.3, " |\\"), (99, "  \\")]
# Key levels top-to-bottom (paired with the magnitude/label/slope/value rows).
LEVEL_ROWS = [("i3", "I3+"), ("i2", "I2"), ("i1", "I1"), ("leaf", "L")]
BRACKETS = [(1, "top"), (2, "top2"), (4, "top4"), (8, "top8"), (16, "top16")]

# An underlined '+' renders the "plus or minus" spread (the most inclusive glyph).
PM = "\x1b[4m+\x1b[24m"
_ESC = re.compile(r"\x1b\[[0-9;]*m")


def vlen(s):
    return len(_ESC.sub("", s))


def vljust(s, w):
    return s + " " * max(0, w - vlen(s))


def humanize(v):
    """Two-to-three significant figures with K/M/G/T suffix; plain below 1000."""
    v = int(v)
    if v < 1000:
        return str(v)
    for unit, div in (("T", 1e12), ("G", 1e9), ("M", 1e6), ("K", 1e3)):
        if v >= div:
            scaled = v / div
            return ("%.1f%s" % (scaled, unit)) if scaled < 10 else ("%d%s" % (round(scaled), unit))
    return str(v)


def mag_glyph(v):
    """Order-of-magnitude glyph: dots for thousands (.=1e3, ..=1e4, ...=1e5),
    stars for millions and up (*=1e6, **=1e7, ...). Blank below 1000."""
    if v < 1000:
        return ""
    e = int(math.floor(math.log10(v)))
    return ("." * (e - 2)) if e < 6 else ("*" * (e - 5))


def slope_cell(weights):
    """Map a five-bucket position distribution to a slope cell (glyph + offset)."""
    tot = sum(weights)
    if tot == 0:
        return ""
    com = sum(i * w for i, w in enumerate(weights)) / tot
    for cutoff, cell in _SLOPE_CELL:
        if com < cutoff:
            return cell
    return "  \\"


def fold_size(stats):
    """Render an (mean, sd, n) triple as 'mean (<u>+</u>sd)', flagging small n."""
    mean, sd, n = stats
    if n <= 0:
        return ""
    s = "%s (%s%s)" % (humanize(round(mean)), PM, humanize(round(sd)))
    if n < fu.Btree.SMALL_N:
        s += " <<"
    return s


def aggregate(intervals):
    """Sum a set of interval snapshots into one btree-id -> Btree dict."""
    out = {}
    for iv in intervals:
        for bid, bt in iv.btrees.items():
            agg = out.get(bid)
            if agg is None:
                agg = out[bid] = fu.Btree(bid, bt.uri)
            agg.add(bt)
    return out


def brackets(intervals):
    """For each btree id, the headline (pct, label): the tightest bracket it sits
    in for >=50% of intervals, else its raw top-16 presence."""
    n = len(intervals) or 1
    counts = {}  # bid -> {K: intervals ranked <= K}
    for iv in intervals:
        ranked = sorted(iv.btrees.values(), key=lambda b: b.op_total(), reverse=True)
        for pos, bt in enumerate(ranked, start=1):
            c = counts.setdefault(bt.id, {k: 0 for k, _ in BRACKETS})
            for k, _ in BRACKETS:
                if pos <= k:
                    c[k] += 1
    out = {}
    for bid, c in counts.items():
        chosen = None
        for k, label in BRACKETS:
            if c[k] / n >= 0.5:
                chosen = (round(100 * c[k] / n), label)
                break
        if chosen is None:
            chosen = (round(100 * c[16] / n), "top16")
        out[bid] = chosen
    return out


def header_line(rank, bt, hl):
    pct, label = hl
    name = bt.uri if bt.id >= 0 else ("(HS)" if bt.id == -1 else "(random)")
    rf = bt.read_frac()
    readstr = "%d%% read" % round(rf * 100) if rf is not None else "  -  "
    tag = "(%d%% %s)" % (pct, label) if bt.id >= 0 else "(%s)" % name
    head = "#%-2d %-13s %-26s %9s %6s" % (rank, tag, name[:26], readstr, humanize(bt.access_total()))
    if bt.is_column_store():
        head += "  [COLUMN-STORE]"  # unusual for MongoDB (collections are row-store)
    return head


# Trees that split far fewer pages into many more (>= this factor) grow fast on a small footprint --
# worth flagging in the leaderboard's one-line collapsed view.
_SPLIT_FLAG_FACTOR = 10


def split_factor(bt):
    """Resulting pages / splitting pages, closest integer, or None when there were no splits."""
    sp = bt.split
    return round(sp["pages"] / sp["count"]) if sp["count"] else None


def collapsed_tail(bt):
    """Trailing magnitude glyph for the collapsed view, plus a split-factor flag for fast-growing
    trees. The glyph is padded so the flags line up across rows despite the glyph's varying width."""
    glyph = mag_glyph(bt.access_total())
    f = split_factor(bt)
    if f is not None and f >= _SPLIT_FLAG_FACTOR:
        return "  %-3s  %dx splits" % (glyph, f)
    return "  " + glyph


def _op_row(cell_fn):
    """Lay out one op row: read group, divider gap, write group."""
    read = "".join("%-*s" % (COL_W, cell_fn(o)) for o in READ_COLS)
    write = "".join("%-*s" % (COL_W, cell_fn(o)) for o in WRITE_COLS)
    return INDENT + read + RW_GAP + write


# Width of the op block, and the column where the "|" divider (and the level
# table / keysz-valuesz headers to its right) begins -- a little past the block.
_LEFT_W = len(INDENT) + len(READ_COLS) * COL_W + len(RW_GAP) + len(WRITE_COLS) * COL_W
_DIV_COL = _LEFT_W + 5

# Split summary line. Its indent is normally _LEFT_W so it sits under the right of the card, but is
# pulled left when even the widest case (5-char humanized numbers, a 2-digit factor) would overflow
# a 100-column screen. A pathological larger value still overflows, which is acceptable.
_SPLIT_FMT = "splits: ~%s keys/P   %s -> %s P : %sx"
_SPLIT_INDENT = " " * max(0, min(_LEFT_W, 100 - len(_SPLIT_FMT % ("1000K", "1000K", "1000K", "99"))))


def card_body(bt):
    """The four-row op matrix (magnitude / labels / slope / values) joined with
    the right-hand four-row key/value-size level table."""
    def mag(o):
        return mag_glyph(bt.op_total_for(o))

    def lab(o):
        return OP_LABEL[o]

    def slope(o):
        return slope_cell(bt.op_by_position(o)) if bt.op_total_for(o) else ""

    def val(o):
        t = bt.op_total_for(o)
        return humanize(t) if t else ""

    left = [_op_row(mag), _op_row(lab), _op_row(slope), _op_row(val)]

    right = []
    for (lvl, lbl) in LEVEL_ROWS:
        ks = fold_size(bt.key_stats(lvl))
        if lvl == "leaf":
            vs = fold_size(bt.val_stats())
            cell = vljust(ks, 16) + vs if vs else ks
        else:
            cell = ks
        right.append(("%-4s %s" % (lbl, cell)).rstrip())
    rows = [("%-*s | %s" % (_DIV_COL, left[i], right[i])).rstrip() for i in range(4)]
    # Blank line, then the split summary: estimated keys per splitting page, splitting-pages ->
    # resulting-pages, and the split factor (resulting / splitting, closest integer). Just
    # "splits:" when there were none.
    sp = bt.split
    rows.append("")
    if sp["count"]:
        rows.append(_SPLIT_INDENT + _SPLIT_FMT % (
            humanize(round(sp["keys"] / sp["count"])), humanize(sp["count"]),
            humanize(sp["pages"]), split_factor(bt)))
    else:
        rows.append(_SPLIT_INDENT + "splits:")
    return rows


def _iso(ms):
    return datetime.datetime.utcfromtimestamp(ms / 1000).isoformat() if ms else "?"


def _aggregate_window(timeline, ws, we):
    """Aggregate one timeline's intervals within [ws, we] into ranked btrees,
    dropping the idle (0-traffic) detail slots. The snapshot always publishes a
    fixed set of slots, so idle leftovers would otherwise show as noise."""
    ivs = [iv for iv in timeline.intervals if ws <= iv.ts_ms <= we]
    aggr = aggregate(ivs)
    hl = brackets(ivs)
    ordered = sorted((b for b in aggr.values() if b.access_total() > 0),
                     key=lambda b: b.access_total(), reverse=True)
    active = max((iv.active_count for iv in ivs), default=0)
    ver = max((iv.version for iv in ivs), default=0)
    return ordered, hl, active, ver


def _section_header(label, n_shown, active, ver, ws, we, ts_fn, zoom_desc=None):
    # "btrees shown" (distinct in the window) and "active per interval" are different
    # measures -- over a window more distinct btrees pass through the slots than are
    # busy in any single interval -- so report them separately, not as "X of Y".
    head = "%s: %d btrees shown" % (label, n_shown)
    if active:
        head += ", up to %d active per interval" % active
    head += "  [%s .. %s]" % (ts_fn(ws), ts_fn(we))
    if ver:
        head += "  (usage v%d)" % ver
    if zoom_desc:
        head += "  (%s)" % zoom_desc
    return head


def render(sections, expanded):
    """Static report: each section rendered over its own full span."""
    out = ["=" * 100]
    for label, tl in sections:
        t0, t1 = tl.span_ms()
        ordered, hl, active, ver = _aggregate_window(tl, t0, t1)
        out.append(_section_header(label, len(ordered), active, ver, t0, t1, _iso))
        out.append("")
        for rank, bt in enumerate(ordered, start=1):
            h = header_line(rank, bt, hl.get(bt.id, (0, "top16"))).rstrip()
            if expanded:
                out.append(vljust(vljust(h, _DIV_COL + 8) + "keysz", _DIV_COL + 24) + "valuesz")
                out.extend(card_body(bt))
                out.append("")
            else:
                out.append(h + collapsed_tail(bt))
        out.append("=" * 100)
    return "\n".join(out)


def _ts(ms):
    return datetime.datetime.utcfromtimestamp(ms / 1000).strftime("%H:%M:%S") if ms else "?"


def _strip(s):
    return _ESC.sub("", s)


class Zoom:
    """A flat zoom over the timeline. At level L the whole span is divided into
    SPLIT**L equal parts and one is selected by absolute index; there is no tree.
    ctrl-down/up change the level (split more/less), ctrl-left/right pan the index
    across the entire range (not bounded by any parent)."""

    SPLIT = 4
    MIN_PART_MS = 1000  # don't zoom finer than ~1s, the FTDC sample resolution

    def __init__(self, t0, t1):
        self.t0, self.t1 = t0, t1
        self.level = 0
        self.index = 0

    def parts(self):
        return self.SPLIT ** self.level

    def window(self):
        span = (self.t1 - self.t0) / self.parts()
        return (self.t0 + self.index * span, self.t0 + (self.index + 1) * span)

    def zoom_in(self):
        if (self.t1 - self.t0) / (self.parts() * self.SPLIT) < self.MIN_PART_MS:
            return False
        self.level += 1
        self.index *= self.SPLIT  # land on the first sub-part of the current window
        return True

    def zoom_out(self):
        if self.level == 0:
            return False
        self.level -= 1
        self.index //= self.SPLIT
        return True

    def pan(self, delta):
        nidx = self.index + delta
        if nidx < 0 or nidx >= self.parts():
            return False
        self.index = nidx
        return True

    def describe(self):
        if self.level == 0:
            return "whole span"
        return "level %d, part %d/%d" % (self.level, self.index + 1, self.parts())


def _build_items(sections, zoom, expanded):
    """Navigable items across all sections for the current (global) zoom window.
    Each item is {anchor, body, bid, sec}; section headers have bid=None. The
    expanded map is keyed by (section_index, btree_id) since ids repeat per node."""
    ws, we = zoom.window()
    items = []
    for si, (label, tl) in enumerate(sections):
        ordered, hl, active, ver = _aggregate_window(tl, ws, we)
        head = _section_header(label, len(ordered), active, ver, ws, we, _ts, zoom.describe())
        items.append({"anchor": head, "body": [], "bid": None, "sec": si})
        for rank, bt in enumerate(ordered, start=1):
            h = header_line(rank, bt, hl.get(bt.id, (0, "top16"))).rstrip()
            if expanded.get((si, bt.id), False):
                anchor = vljust(vljust(h, _DIV_COL + 8) + "keysz", _DIV_COL + 24) + "valuesz"
                body = card_body(bt)
            else:
                anchor = h + collapsed_tail(bt)
                body = []
            items.append({"anchor": anchor, "body": body, "bid": bt.id, "sec": si})
    return items


_HINTS = "Arrow keys or jk move   space expand   shift-arrow or HJKL time   ? help   q quit"

# Custom keycodes for shift-arrows (above curses.KEY_MAX so they never collide).
_SHIFT_UP, _SHIFT_DOWN, _SHIFT_RIGHT, _SHIFT_LEFT = 1001, 1002, 1003, 1004


def _define_shift_arrows():
    """Map the shift-arrow escape sequences (xterm '1;2' modifier, and the 'O'
    form) to custom keycodes. Time nav also has the HJKL fallback, so terminals
    that don't forward shift-arrows still work."""
    seqs = {
        "\x1b[1;2A": _SHIFT_UP, "\x1b[1;2B": _SHIFT_DOWN,
        "\x1b[1;2C": _SHIFT_RIGHT, "\x1b[1;2D": _SHIFT_LEFT,
        "\x1bO1;2A": _SHIFT_UP, "\x1bO1;2B": _SHIFT_DOWN,
        "\x1bO1;2C": _SHIFT_RIGHT, "\x1bO1;2D": _SHIFT_LEFT,
    }
    define = getattr(curses, "define_key", None)
    if define is None:
        return
    for seq, code in seqs.items():
        try:
            define(seq, code)
        except curses.error:
            pass


def _setup_colors():
    """Black text on a light MongoDB-leaf-green background, with a brighter-green
    row highlight. Returns (normal_attr, highlight_attr) or None if no color."""
    if not curses.has_colors():
        return None
    curses.start_color()
    try:
        if curses.can_change_color() and curses.COLORS > 17:
            curses.init_color(16, 843, 1000, 843)   # pale leaf  (~#d7ffd7)
            curses.init_color(17, 686, 1000, 686)   # brighter leaf for the cursor row
            norm_bg, hi_bg = 16, 17
        elif curses.COLORS >= 256:
            norm_bg, hi_bg = 194, 157                # xterm-256 light greens
        else:
            norm_bg, hi_bg = curses.COLOR_GREEN, curses.COLOR_GREEN
        curses.init_pair(1, curses.COLOR_BLACK, norm_bg)
        curses.init_pair(2, curses.COLOR_BLACK, hi_bg)
        return curses.color_pair(1), curses.color_pair(2)
    except curses.error:
        return None



# This is a test workload for eviction
conn_config="cache_size=10GB,eviction=(threads_max=8),log=(enabled=true),session_max=250,statistics=(fast),statistics_log=(wait=1,json=true),io_capacity=(total=30M)"
table_config="memory_page_max=10m,leaf_value_max=64MB,checksum=on,split_pct=90,type=file,log=(enabled=false),leaf_page_max=32k"
table_count=10
max_idle_table_cycle=2
random_range=1500000000
pareto=10
range_partition=true
report_interval=10
populate_threads = 4
icount = 1000000
pre_load_data=true
run_time=200
threads=((count=10,inserts=1,throttle=1000),(count=10,reads=1))
max_latency=1000
sample_interval=1
sample_rate=1
warmup=0
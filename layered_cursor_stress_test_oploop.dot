// Layered cursor stress test -- per-sequence operation loop (config-driven generation).
// Render:  dot -Tsvg layered_cursor_stress_test_oploop.dot -o arch_oploop.svg
digraph layered_cursor_stress_oploop {
  rankdir=TB;
  fontname="Helvetica"; labelloc=t; fontsize=15;
  label="Layered cursor stress test — per-sequence loop (run_sequence / pick_op / op_* methods)";
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10];

  start  [shape=oval, fillcolor="#e8eef7", label="run_sequence(seed, n_ops)\nmake_nodes · state.new_sequence()"];
  loop   [shape=diamond, fillcolor="#f0f0f0", label="n_ops\nremaining?"];
  verify [shape=oval, fillcolor="#ede7f6", label="verify(): per-node lay==ref;\nleader scan == follower scan"];

  // pick_op: the config-driven generator
  mode   [fillcolor="#e8eef7", label="pick_op(nodes, trace, rnd)\nmode = _mode() ; positioned?\nlegal = [op in OPS if op_legal(op, mode, positioned)]"];
  txnq   [shape=diamond, fillcolor="#fff4e5", label="legal txn op\nand rand < P_TXN?"];
  brkq   [shape=diamond, fillcolor="#f0f0f0", label="rand < P_BREAK?"];
  pooltxn [fillcolor="#fff4e5", label="pool = txn ops\n(begin | commit/rollback)"];
  poolbrk [fillcolor="#fdeaea", label="pool = break ops\n(put/remove/reset/advance/evict/full_scan)"];
  poolkeep[fillcolor="#e6f4ea", label="pool = keep ops\n(next/prev/search/search_near/pos_update/pos_remove)"];
  sample [fillcolor="#e8eef7", label="weighted-sample pool by Op.weight\nbind arg -> bound callable op()"];

  // the callable runs one op_* method (which updates self.state)
  run    [fillcolor="#eef2ff", label="op()  ->  one op_* method\ntrace + perform + update state"];

  start -> loop;
  loop  -> mode   [label="yes"];
  loop  -> verify [label="no (close open txn first)"];

  mode -> txnq;
  txnq -> pooltxn [label="yes"];
  txnq -> brkq    [label="no"];
  brkq -> poolbrk [label="yes"];
  brkq -> poolkeep[label="no"];
  pooltxn  -> sample;
  poolbrk  -> sample;
  poolkeep -> sample;
  sample -> run;
  run    -> loop;

  // note on the oracle
  note [shape=note, fillcolor="#fbfbe6", label="reads go through _do_read:\ncompare lay==ref on BOTH nodes,\nthen anchor cur_pos iff leader key == follower key"];
  run -> note [style=dotted, arrowhead=none];
}

// Layered cursor stress test -- per-sequence operation loop (config-driven generation).
// Render:  dot -Tsvg layered_cursor_stress_test_oploop.dot -o arch_oploop.svg
digraph layered_cursor_stress_oploop {
  rankdir=TB;
  fontname="Helvetica"; labelloc=t; fontsize=15;
  label="Layered cursor stress test — per-sequence loop (run_sequence / pick_op / op_* methods)";
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10];

  start  [shape=oval, fillcolor="#e8eef7", label="run_sequence(seed, n_ops)\nmake_nodes · state.new_sequence()"];
  loop   [shape=diamond, fillcolor="#f0f0f0", label="n_ops\nremaining?"];
  verify [shape=oval, fillcolor="#ede7f6", label="verify(): per-node lay==ref;\nleader scan == follower scan"];

  // pick_op: the config-driven generator
  mode   [fillcolor="#e8eef7", label="pick_op(nodes, rnd, trace)\npositioned = cur_pos in live?"];
  cand   [fillcolor="#e8eef7", label="_candidates(positioned): walk DEFAULT_WEIGHTS\nleaf -> its weight; group -> its share, split over\n(normalised) children; keep only _legal(spec, positioned)"];
  grp    [shape=note, fillcolor="#fff4e5", label="groups (contribute exactly their .weight):\n txn  -> begin  (no txn open)  |  commit/rollback (txn open)\n scenarios -> advance / evict"];
  sample [fillcolor="#e8eef7", label="weighted-sample candidates by effective weight\n-> lambda: spec.fn(nodes, rnd, trace)"];

  // the callable runs one op_* method (which updates self.state)
  run    [fillcolor="#eef2ff", label="op()  ->  one op_* method\nself-contained: arg-gen + trace + perform + update state"];

  start -> loop;
  loop  -> mode   [label="yes"];
  loop  -> verify [label="no (close open txn first)"];

  mode -> cand;
  cand -> grp [style=dotted, arrowhead=none];
  cand -> sample;
  sample -> run;
  run    -> loop;

  // note on the oracle
  note [shape=note, fillcolor="#fbfbe6", label="reads go through _read / _read_near:\ncompare lay==ref on BOTH nodes,\nthen anchor cur_pos iff leader key == follower key"];
  run -> note [style=dotted, arrowhead=none];
}

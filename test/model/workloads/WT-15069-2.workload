# The same crash without connection logging: nothing makes the committed metadata durable, the
# turtle file still names the previous checkpoint, and the key written after it is rolled back.
create_table(1, "table1", "Q", "Q")
begin_transaction(1)
insert(1, 1, 10, 100)
commit_transaction(1, 10)
set_stable_timestamp(10)
checkpoint()
begin_transaction(2)
insert(1, 2, 20, 200)
commit_transaction(2, 20)
set_stable_timestamp(20)
checkpoint_crash("before_metadata_sync")
begin_transaction(3)
get(1, 3, 20)
commit_transaction(3, 30)

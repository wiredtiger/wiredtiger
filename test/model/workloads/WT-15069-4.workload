# A numeric crash point on a checkpoint that has nothing to write: there is no data handle to stop
# on, so the crash has to be taken up front instead of never happening at all.
create_table(1, "table1", "Q", "Q")
begin_transaction(1)
insert(1, 1, 10, 100)
commit_transaction(1, 10)
set_stable_timestamp(10)
checkpoint()
checkpoint_crash(500)
begin_transaction(2)
get(1, 2, 10)
commit_transaction(2, 20)

# Crashing before the checkpoint transaction commits loses the checkpoint even with logging
# enabled, because there is nothing committed for recovery to replay.
wt_config("connection", "log=(enabled=true)")
create_table(1, "table1", "Q", "Q")
begin_transaction(1)
insert(1, 1, 10, 100)
commit_transaction(1, 10)
set_stable_timestamp(10)
checkpoint()
begin_transaction(2)
insert(1, 2, 20, 200)
commit_transaction(2, 20)
set_stable_timestamp(20)
checkpoint_crash("before_checkpoint_commit")
begin_transaction(3)
get(1, 3, 20)
commit_transaction(3, 30)

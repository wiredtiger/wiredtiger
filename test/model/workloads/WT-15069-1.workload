# With connection logging, a crash after the checkpoint transaction commits leaves a recoverable
# checkpoint: the metadata updates are in the log, so recovery rolls the checkpoint forward and
# the key written after the previous checkpoint survives.
wt_config("connection", "log=(enabled=true)")
create_table(1, "table1", "Q", "Q")
begin_transaction(1)
insert(1, 1, 10, 100)
commit_transaction(1, 10)
set_stable_timestamp(10)
checkpoint()
begin_transaction(2)
insert(1, 2, 20, 200)
commit_transaction(2, 20)
set_stable_timestamp(20)
checkpoint_crash("before_metadata_sync")
begin_transaction(3)
get(1, 3, 20)
commit_transaction(3, 30)

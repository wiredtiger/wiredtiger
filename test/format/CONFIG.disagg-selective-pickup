############################################
#  Disaggregated storage, multi-node (leader + follower), with selective checkpoint pickup on the
#  follower. multi_validation compares leader vs follower content for equality -- a deferral bug
#  (e.g. over-pruning ingest) shows up as a validation mismatch, deterministically under predictable
#  replay.
############################################
backup=0
background_compact=0
block_cache=0
# FIXME-WT-14738: Enable reverse collator once it is available for layered tables.
btree.reverse=0
checkpoint=on
precise_checkpoint=1
disagg.page_log=palite
disagg.enabled=1
disagg.layered=1
disagg.multi=1
disagg.multi_validation=1
disagg.preserve=1
disagg.checkpoint_pickup_defer_period=3
runs.predictable_replay=1
runs.source=layered
runs.type=row-store
runs.tables=3
runs.rows=10000
ops.verify=1
# FIXME-WT-17278: removes are not yet supported in disagg multi mode.
ops.pct.delete=0
import=0
ops.alter=0
ops.compaction=0
ops.salvage=0
ops.throttle=0
quiet=0
runs.in_memory=0
transaction.timestamps=1
tiered_storage.flush_frequency=0
tiered_storage.storage_source=off
wiredtiger.config=disaggregated=(checkpoint_pickup_defer_min_kb=1048576)

{
  "_comments": [
    "// Disaggregated storage code coverage test configuration.",
    "//",
    "// This config covers the Python-level disagg test types:",
    "//   1. test_layered*.py  — native layered table tests (103 files)",
    "//   2. test_disagg*.py   — disagg-specific Python tests (10 files)",
    "//   3. hook-leader       — general suite tests re-run via hook_disagg (leader role)",
    "//   4. hook-follower     — minimal follower-role hook test (base01 group only)",
    "//   5. catch2-unittests  — includes test_disagg_meta_config",
    "//",
    "// Format stress tests (CONFIG.disagg) and checkpoint ctest (check_disagg label)",
    "// are handled separately in disagg_coverage.sh because they require",
    "// special execution environments (subdirectory changes, ctest path setup).",
    "//",
    "// Tests are ordered roughly by expected duration (longest first) so that the",
    "// parallel scheduler keeps all workers busy until the very end.",
    "//",
    "// The build setup is identical to the main coverage config: CMake Coverage build",
    "// with PALite included (built as part of the normal extension tree).",
    "// See analysis/disagg_testing/HOW_TO_RUN_COVERAGE.md for run instructions."
  ],
  "setup_actions": [
    "cmake -DHAVE_UNITTEST=1 -DHAVE_DIAGNOSTIC=0 -DCODE_COVERAGE_MEASUREMENT=1 -DINLINE_FUNCTIONS_INSTEAD_OF_MACROS=1 -DCMAKE_TOOLCHAIN_FILE=../cmake/toolchains/mongodbtoolchain_stable_gcc.cmake -DCMAKE_BUILD_TYPE=Coverage -G Ninja ../.",
    "ninja -j 16"
  ],

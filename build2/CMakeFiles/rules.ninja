#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /opt/mongodbtoolchain/revisions/8695910c32ef0ee5eecaae4c9ca515b4b6436a40/stow/cmake-v5.jbN/bin/cmake --regenerate-during-build -S/data/work/git/wiredtiger2 -B/data/work/git/wiredtiger2/build2
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = /opt/mongodbtoolchain/revisions/8695910c32ef0ee5eecaae4c9ca515b4b6436a40/stow/cmake-v5.jbN/bin/cmake -DCONFIG=$CONFIG -P CMakeFiles/clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /opt/mongodbtoolchain/v5/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /opt/mongodbtoolchain/v5/bin/ninja -t targets
  description = All primary targets available:

